generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection string
  directUrl = env("DIRECT_URL")   // Neon direct (non-pooled) connection string, used by prisma db push
}

// One row, key = "main". Holds every calculator input (offer, split, expenses, NACA, etc.)
// as JSON so new fields never need a migration.
model Settings {
  key       String   @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt
}

// The payoff / scratch list: credit card, utilities, parents, car, ...
model PlanItem {
  id        String    @id @default(cuid())
  title     String
  group     String    @default("")
  amount    Float
  paid      Float     @default(0) // partial progress
  position  Int
  done      Boolean   @default(false)
  doneAt    DateTime?
  note      String    @default("")
  createdAt DateTime  @default(now())
}

// Actual money events: paychecks, stock sales, bonus, side income, one-off expenses.
model LogEntry {
  id        String   @id @default(cuid())
  date      DateTime
  kind      String // paycheck | stock | bonus | side | expense
  source    String   @default("")
  amount    Float // net dollars (positive)
  note      String   @default("")
  createdAt DateTime @default(now())
}
