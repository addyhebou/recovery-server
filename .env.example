# Neon → Dashboard → Connection Details
# Pooled string (host contains "-pooler"), used at runtime:
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
# Direct string (no "-pooler"), used by `prisma db push`:
DIRECT_URL="postgresql://USER:PASS@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require"

# The only login. Changing it signs out every device.
PASSWORD="change-me"

# Optional: lock CORS to your client URL(s), comma-separated. Leave unset to allow any origin.
# CLIENT_ORIGIN="https://recovery-client.vercel.app"

PORT=4000
